binder_use(platform_app_all)
binder_call(platform_app_all, hal_camera_default)

allow platform_app_all hal_aidlbgservice_service:service_manager find;

allow platform_app_all adsprpcd_file:dir { open read search };

allow platform_app_all vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_all vendor_camera_data_file:file { getattr open read };

allow platform_app_all app_data_file:file execute;

# CAM-Work threads sample PSI for the app's performance stats
allow platform_app_all { proc_pressure_cpu proc_pressure_io proc_pressure_mem }:file r_file_perms;

# Properties
get_prop(platform_app_all, vendor_audio_prop)
get_prop(platform_app_all, vendor_camera_p3enable_prop)
get_prop(platform_app_all, vendor_camera_sensor_prop)
get_prop(platform_app_all, vendor_display_prop)
get_prop(platform_app_all, vendor_displayfeature_prop)
get_prop(platform_app_all, vendor_panel_info_prop)
